Screen {
    background: $surface;
}

#panels-row {
    height: 70%;
    width: 100%;
}

.pi-panel {
    width: 1fr;
    height: 100%;
    border: solid $primary;
    padding: 1;
    min-width: 20;
}

#command-panel {
    height: 30%;
    border: solid $primary;
    padding: 1;
}

#status-bar {
    height: 3;
    background: $panel;
    padding: 1;
}

.panel-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.help-text {
    color: $text-muted;
    margin-bottom: 1;
}

#command-input {
    margin-top: 1;
}

